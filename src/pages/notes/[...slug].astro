---
import { type CollectionEntry, getCollection, render } from 'astro:content'
import PostLayout from '@/layouts/PostLayout.astro'

export async function getStaticPaths() {
  const notes = await getCollection('notes')
  return notes
    .filter((note) => !note.id.startsWith('_'))
    .map((note) => ({
      params: { slug: note.id },
      props: note
    }))
}

type Props = CollectionEntry<'notes'>

const note = Astro.props
const { Content, remarkPluginFrontmatter } = await render(note)

const toc = remarkPluginFrontmatter.toc || []
const contentFeatures = remarkPluginFrontmatter.contentFeatures || {}
---

<PostLayout {...note.data} toc={toc} contentFeatures={contentFeatures}>
  <Content />
</PostLayout>

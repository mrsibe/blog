---
import IndexLayout from '@/layouts/IndexLayout.astro'
import { themeConfig } from '@/config'

const friends = themeConfig.friends ?? []
---

<IndexLayout title={`友情链接 · ${themeConfig.site.title}`} description={themeConfig.site.description}>
  <main>
    <h1 class="sr-only">友情链接</h1>
    {friends.length > 0 ? (
      <ul class="friends">
        {friends.map((friend) => (
          <li>
            <a href={friend.url} target="_blank" rel="noopener noreferrer">
              {friend.avatar && <img class="avatar" src={friend.avatar} alt="" width="40" height="40" loading="lazy" />}
              <span class="info">
                <span class="name">{friend.name}</span>
                {friend.description && <span class="description">{friend.description}</span>}
              </span>
            </a>
          </li>
        ))}
      </ul>
    ) : (
      <p class="empty">暂无友链</p>
    )}
  </main>
</IndexLayout>

<style>
  .friends {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .friends a {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.75rem 1rem;
    border: 0.5px solid var(--border);
    border-radius: 8px;
    color: var(--text-primary);
    text-decoration: none;
    transition: background 0.2s ease-out;
  }

  .friends a:hover {
    background: color-mix(in srgb, var(--selection) 75%, transparent);
  }

  .avatar {
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 50%;
    object-fit: cover;
    background: var(--astro-code-background);
    flex-shrink: 0;
  }

  .info {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    min-width: 0;
  }

  .name {
    font-weight: var(--font-weight-bold);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .description {
    font-size: var(--font-size-s);
    color: var(--text-secondary);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .empty {
    color: var(--text-secondary);
  }
</style>

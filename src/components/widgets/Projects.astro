---
import GitHubCard from '@/components/ui/GitHubCard.astro'
import { themeConfig } from '@/config'

const repos = (themeConfig.projects ?? []).map((repo) => {
  const [owner, name] = repo.split('/')
  return { owner, name, repo }
})
---

{repos.length > 0 && (
  <section class="projects">
    {repos.map(({ owner, name, repo }) => (
      <a
        href={`https://github.com/${repo}`}
        class="gc-container"
        target="_blank"
        rel="noopener noreferrer"
        data-repo={repo}
      >
        <div class="gc-title-bar">
          <div
            class="gc-owner-avatar"
            style="background-size: cover; background-position: center;"
            aria-hidden="true"
          />
          <span class="gc-repo-title">
            <span>
              {owner}
              <span class="gc-slash" aria-hidden="true">
                /
              </span>
              <strong>{name}</strong>
            </span>
          </span>
          <span class="gc-info-bar">
            <svg class="gc-info-icon" height="16" width="16" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
              <path d="M8 .25a.75.75 0 0 1 .673.418l1.882 3.815 4.21.612a.75.75 0 0 1 .416 1.279l-3.046 2.97.719 4.192a.751.751 0 0 1-1.088.791L8 12.347l-3.766 1.98a.75.75 0 0 1-1.088-.79l.72-4.194L.818 6.374a.75.75 0 0 1 .416-1.28l4.21-.611L7.327.668A.75.75 0 0 1 8 .25Zm0 2.445L6.615 5.5a.75.75 0 0 1-.564.41l-3.097.45 2.24 2.184a.75.75 0 0 1 .216.664l-.528 3.084 2.769-1.456a.75.75 0 0 1 .698 0l2.77 1.456-.53-3.084a.75.75 0 0 1 .216-.664l2.24-2.183-3.096-.45a.75.75 0 0 1-.564-.41L8 2.694Z" />
            </svg>
            <span class="gc-stars-count" aria-label="Stars count">
              --
            </span>
          </span>
        </div>
        <p class="gc-repo-description">--</p>
      </a>
    ))}
    <GitHubCard />
  </section>
)}

<style>
  .projects {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    margin-bottom: var(--section-gap);
  }
</style>

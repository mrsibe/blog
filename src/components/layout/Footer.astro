---
import { themeConfig } from '@/config'
const today = new Date()

const social = themeConfig.social || {}
const socialLinks = [
  social.github && { href: social.github, label: 'GitHub', icon: 'github' },
  social.x && { href: social.x, label: 'X', icon: 'x' },
  social.rss && { href: '/rss.xml', label: 'RSS', icon: 'rss' }
].filter(Boolean) as { href: string; label: string; icon: string }[]
---

<footer>
  <div class="footer-content">
    <div class="copyright">
      <span class="date">
        &copy;
        {today.getFullYear()}
      </span>
      <span class="separator" aria-hidden="true">
        ·
      </span>
      {themeConfig.site.author}
    </div>
    {socialLinks.length > 0 && (
      <div class="social">
        {socialLinks.map(({ href, label, icon }) => (
          <a
            href={href}
            aria-label={label}
            title={label}
            target={href.startsWith('http') ? '_blank' : undefined}
            rel={href.startsWith('http') ? 'me noopener noreferrer' : undefined}
          >
            {icon === 'github' && (
              <svg viewBox="0 0 16 16" aria-hidden="true">
                <path
                  fill="currentColor"
                  d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"
                />
              </svg>
            )}
            {icon === 'x' && (
              <svg viewBox="0 0 16 16" aria-hidden="true">
                <path
                  fill="currentColor"
                  d="M12.6 1.5h2.23l-4.87 5.57 5.73 7.43h-4.49L7.58 8.86l-4.15 4.64H1.2l5.21-5.95L.9 1.5h4.6l3.13 4.14 3.97-4.14Zm-.78 12.13h1.24L4.25 2.68H2.92l8.9 10.95Z"
                />
              </svg>
            )}
            {icon === 'rss' && (
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path
                  fill="currentColor"
                  d="M19.199 24C19.199 13.467 10.533 4.8 0 4.8V0c13.165 0 24 10.835 24 24h-4.801zM3.291 17.415c1.814 0 3.293 1.479 3.293 3.295 0 1.813-1.485 3.29-3.301 3.29C1.47 24 0 22.526 0 20.71s1.475-3.294 3.291-3.295zM15.909 24h-4.665c0-6.169-5.075-11.245-11.244-11.245V8.09c8.727 0 15.909 7.184 15.909 15.91z"
                />
              </svg>
            )}
          </a>
        ))}
      </div>
    )}
  </div>
</footer>
<style>
  footer {
    font-size: var(--font-size-s);
    font-weight: var(--font-weight-regular);
    line-height: 1.75;
    color: var(--text-secondary);
    margin-top: var(--space-7);
  }

  .footer-content {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-direction: row;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-5);
    width: 100%;
  }

  .social {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .social a {
    display: inline-flex;
    color: inherit;
    transition: color 0.2s ease-out;
  }

  .social a:hover {
    color: var(--text-primary);
  }

  .social svg {
    width: 0.875rem;
    height: 0.875rem;
    display: block;
  }

  .copyright {
    white-space: nowrap;
  }

  .copyright .date {
    color: var(--text-secondary);
  }

  .copyright .separator {
    margin: 0 var(--space-1);
    color: var(--text-tertiary);
  }

  footer a {
    color: var(--text-secondary);
    text-decoration: none;
    transition: color 0.2s ease-out;
  }

  footer a:hover {
    color: var(--text-primary);
  }
</style>
